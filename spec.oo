// # openOODA CLI Driver — Language Specification Reader
//
// Logline: Display the Tier A language specification sheet in the terminal.
//
// Setup: Multi-path resolution under FsReadCap and EnvCap. Resolves spec.oot from repo roots and user home.
//
// Beats:
//   1. Resolve candidate paths for spec.oot.
//   2. Read spec file content via FsReadCap.
//   3. Stream content to terminal output.
//   4. Return error if file is missing.

import "std/fs/process/env.oo";

fn resolve_spec_path(fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> String {
    if list_len(args) > 0 {
        let custom: String = list_get(args, 0);
        if path_exists(fs_r, custom) { return custom; }
    }
    if path_exists(fs_r, "openOODA/spec.oot") { return "openOODA/spec.oot"; }
    if path_exists(fs_r, "spec.oot") { return "spec.oot"; }
    if path_exists(fs_r, "../openOODA/spec.oot") { return "../openOODA/spec.oot"; }
    if path_exists(fs_r, "../../openOODA/spec.oot") { return "../../openOODA/spec.oot"; }
    let spec_env: Result[String, String] = env_get(env, "OODASPEC");
    let oodaspec: String = match spec_env { Ok(s) => s, Err(_) => "" };
    if oodaspec != "" && path_exists(fs_r, oodaspec) { return oodaspec; }
    let home_res: Result[String, String] = env_get(env, "HOME");
    let home: String = match home_res { Ok(s) => s, Err(_) => "" };
    if home != "" && path_exists(fs_r, home + "/.openooda/spec.oot") {
        return home + "/.openooda/spec.oot";
    }
    if path_exists(fs_r, "~/.openooda/spec.oot") {
        return "~/.openooda/spec.oot";
    }
    return "";
}

pub fn run_cli_spec(fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let path: String = resolve_spec_path(fs_r, env, args);
    if path == "" {
        println("cli spec: spec.oot not found");
        return Err("cli spec: spec.oot not found");
    }
    let res: Result[String, String] = read_file(fs_r, path);
    if res.is_err() {
        let err_msg: String = match res { Ok(_) => "", Err(m) => m };
        println("cli spec: " + err_msg);
        return Err(err_msg);
    }
    let content: String = match res { Ok(s) => s, Err(_) => "" };
    print(content);
    return Ok(0);
}
