// # cli QA Suite — Help, Version, Unknown Sub, Build, Dispatch
//
// Logline: Run help/version/unknown-sub/build/edge/compiler-token/dispatch probes twice against the current cli binary.
//
// Setup: ProcessCap sys_exec. FsReadCap+EnvCap resolve dist/cli or sibling. CWD is the cli root.
//
// Beats:
//   1. Resolve dist/cli, then the cli next to OODA_COMPILER.
//   2. Run every probe twice; report all failures, exit 0 only if none.

import "std/fs/process/env.oo";
import "cmd/probe_help.oo";
import "cmd/probe_version.oo";
import "cmd/probe_unknown.oo";
import "build/probe_build.oo";
import "build/probe_edge.oo";
import "build/probe_compiler_token.oo";
import "cmd/probe_dispatch.oo";

fn sibling_cli(oodac: String) -> String {
    let n: Int = chars_len(oodac);
    let mut slash: Int = 0 - 1;
    let mut i: Int = 0;
    while i < n {
        if str_slice(oodac, i, i + 1) == "/" { slash = i; }
        i = i + 1;
    }
    if slash < 0 { return ""; }
    return str_slice(oodac, 0, slash) + "/cli";
}

fn find_cli(fs: &FsReadCap, env: &EnvCap) -> String {
    if path_exists(fs, "dist/cli") { return "dist/cli"; }
    if path_exists(fs, "dist/cli-linux-x86_64") { return "dist/cli-linux-x86_64"; }
    let cr: Result[String, String] = env_get(env, "OODA_COMPILER");
    let oc: String = match cr { Ok(s) => s, Err(_) => "" };
    if oc != "" {
        let p: String = sibling_cli(oc);
        if p != "" && path_exists(fs, p) { return p; }
    }
    let tr: Result[String, String] = env_get(env, "OODA_TOOLCHAIN");
    let th: String = match tr { Ok(s) => s, Err(_) => "" };
    if th != "" {
        let p: String = th + "/bin/cli";
        if path_exists(fs, p) { return p; }
    }
    return "";
}

fn run_twice(a: Result[Int, String], b: Result[Int, String]) -> Result[Int, String] {
    if a.is_err() { return a; }
    if b.is_err() { return b; }
    return Ok(0);
}

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let _n: Int = list_len(args);
    let bin: String = find_cli(fs_r, env);
    if bin == "" {
        return Err("no cli binary (dist/cli or OODA_COMPILER sibling)");
    }
    println("  cli binary: " + bin);

    let mut failed: Int = 0;
    let mut first_err: String = "";

    println("  Running qa/probe_help.oo");
    let h: Result[Int, String] = run_twice(probe_help(p, bin), probe_help(p, bin));
    if h.is_err() {
        let he: String = match h { Ok(_) => "", Err(m) => m };
        println("FAIL: probe_help: " + he);
        if failed == 0 { first_err = "probe_help: " + he; }
        failed = failed + 1;
    } else {
        println("PASS: probe_help");
    }

    println("  Running qa/probe_version.oo");
    let v: Result[Int, String] = run_twice(probe_version(p, bin), probe_version(p, bin));
    if v.is_err() {
        let ve: String = match v { Ok(_) => "", Err(m) => m };
        println("FAIL: probe_version: " + ve);
        if failed == 0 { first_err = "probe_version: " + ve; }
        failed = failed + 1;
    } else {
        println("PASS: probe_version");
    }

    println("  Running qa/probe_unknown.oo");
    let u: Result[Int, String] = run_twice(probe_unknown(p, bin), probe_unknown(p, bin));
    if u.is_err() {
        let ue: String = match u { Ok(_) => "", Err(m) => m };
        println("FAIL: probe_unknown: " + ue);
        if failed == 0 { first_err = "probe_unknown: " + ue; }
        failed = failed + 1;
    } else {
        println("PASS: probe_unknown");
    }

    println("  Running qa/probe_build.oo");
    let b: Result[Int, String] = run_twice(probe_build(p, fs_r, bin), probe_build(p, fs_r, bin));
    if b.is_err() {
        let be: String = match b { Ok(_) => "", Err(m) => m };
        println("FAIL: probe_build: " + be);
        if failed == 0 { first_err = "probe_build: " + be; }
        failed = failed + 1;
    } else {
        println("PASS: probe_build");
    }

    println("  Running qa/probe_edge.oo");
    let e: Result[Int, String] = run_twice(probe_edge(p, bin), probe_edge(p, bin));
    if e.is_err() {
        let ee: String = match e { Ok(_) => "", Err(m) => m };
        println("FAIL: probe_edge: " + ee);
        if failed == 0 { first_err = "probe_edge: " + ee; }
        failed = failed + 1;
    } else {
        println("PASS: probe_edge");
    }

    println("  Running qa/probe_compiler_token.oo");
    let ct: Result[Int, String] = run_twice(probe_compiler_token(fs_r), probe_compiler_token(fs_r));
    if ct.is_err() {
        let cte: String = match ct { Ok(_) => "", Err(m) => m };
        println("FAIL: probe_compiler_token: " + cte);
        if failed == 0 { first_err = "probe_compiler_token: " + cte; }
        failed = failed + 1;
    } else {
        println("PASS: probe_compiler_token");
    }

    println("  Running qa/probe_dispatch.oo");
    let d: Result[Int, String] = run_twice(probe_dispatch(p, bin), probe_dispatch(p, bin));
    if d.is_err() {
        let de: String = match d { Ok(_) => "", Err(m) => m };
        println("FAIL: probe_dispatch: " + de);
        if failed == 0 { first_err = "probe_dispatch: " + de; }
        failed = failed + 1;
    } else {
        println("PASS: probe_dispatch");
    }

    if failed != 0 {
        println("cli test suite: " + failed.to_string() + " probe(s) failed");
        return Err(first_err);
    }
    println("cli test suite: ALL PROBES PASSED (double-run identical)");
    return Ok(0);
}
