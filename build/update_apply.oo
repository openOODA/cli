// # Hash-based per-component toolchain update
//
// Logline: Compare sha256 of each installed binary to GitHub latest. Download only stale assets. No installer, no shell-rc rewrite.
//
// Setup: ProcessCap runs bash; FsReadCap reads the report file. Mode is check, dry, or apply.
//
// Beats:
//   1. Probe OS/ARCH and walk ooda/cli/tui/oodac/oodar/opm/lsp/mcp/bb.
//   2. Match local sha256 to the latest sidecar; skip current, fetch stale.
//   3. Write a tab report; tty spinner ticks each repo while curl runs.

fn int_to_str(n: Int) -> String {
    if n <= 0 { return "0"; }
    let digits: String = "0123456789";
    let mut v: Int = n;
    let mut rev: String = "";
    while v > 0 { let d: Int = v - (v / 10) * 10; rev = rev + char_at(digits, d); v = v / 10; }
    let mut out: String = "";
    let mut k: Int = chars_len(rev) - 1;
    while k >= 0 { out = out + char_at(rev, k); k = k - 1; }
    return out;
}

fn update_report_path() -> String {
    return "/tmp/.ooda-update-report.txt";
}

fn update_apply_script(mode: String, prefix: String) -> String {
    let rpt: String = update_report_path();
    let pref_line: String = if prefix == "" {
        "PREFIX=\"$HOME/.openooda\"\n"
    } else {
        "PREFIX='" + prefix + "'\n"
    };
    return "set -uo pipefail\n" +
        "MODE='" + mode + "'\n" +
        "HOME=$(getent passwd $(id -un) | cut -d: -f6); HOME=${HOME:-/home/$(id -un)}\n" +
        "if [ \"$HOME\" = \"~\" ]; then HOME=/home/$(id -un); fi\n" +
        pref_line +
        "BIN=\"$PREFIX/bin\"\n" +
        "if [ \"$MODE\" = \"apply\" ]; then mkdir -p \"$BIN\"; fi\n" +
        "RPT=\"" + rpt + "\"; rm -f \"$RPT\"\n" +
        "OS=$(uname -s); case \"$OS\" in Linux) OS=linux;; Darwin) OS=darwin;; *) OS=linux;; esac\n" +
        "ARCH=$(uname -m); case \"$ARCH\" in x86_64|amd64) ARCH=x86_64;; aarch64|arm64) ARCH=arm64;; *) ARCH=x86_64;; esac\n" +
        "GH=https://github.com/openOODA\n" +
        "TTY=0; [ -t 2 ] && TTY=1\n" +
        "FR=\"|/-\\\\\"\n" +
        "TN=0\n" +
        "tick() { [ \"$TTY\" = 1 ] || return 0; TN=$((TN+1)); local n p; n=${#FR}; p=$((TN % n)); printf '\\r  %s  %s   ' \"${FR:$p:1}\" \"$1\" >&2; }\n" +
        "spin() { local p=$1 m=$2; if [ \"$TTY\" = 1 ]; then while kill -0 \"$p\" 2>/dev/null; do tick \"$m\"; sleep 0.08; done; fi; wait \"$p\"; return $?; }\n" +
        "wipe() { [ \"$TTY\" = 1 ] && printf '\\r\\033[K' >&2 || true; }\n" +
        "trap wipe EXIT\n" +
        "sha_of() { if command -v sha256sum >/dev/null 2>&1; then sha256sum \"$1\" | awk '{print $1}'; else shasum -a 256 \"$1\" | awk '{print $1}'; fi; }\n" +
        "printf 'repo\\tbin\\tstatus\\tdetail\\n' > \"$RPT\"\n" +
        "while IFS=' ' read -r repo dest stem; do\n" +
        "  [ -z \"$repo\" ] && continue\n" +
        "  path=\"$BIN/$dest\"\n" +
        "  url=\"$GH/$repo/releases/latest/download/${stem}-${OS}-${ARCH}\"\n" +
        "  sf=$(mktemp); curl -fsSL --connect-timeout 10 -m 20 \"${url}.sha256\" -o \"$sf\" 2>/dev/null &\n" +
        "  spin $! \"$repo\"; crc=$?\n" +
        "  rsha=; [ $crc -eq 0 ] && [ -s \"$sf\" ] && rsha=$(awk '{print $1}' \"$sf\")\n" +
        "  rm -f \"$sf\"\n" +
        "  if [ -z \"$rsha\" ]; then\n" +
        "    if [ ! -e \"$path\" ]; then printf '%s\\t%s\\tskip\\tno-release\\n' \"$repo\" \"$path\" >> \"$RPT\"\n" +
        "    else printf '%s\\t%s\\tfail\\tno-sha\\n' \"$repo\" \"$path\" >> \"$RPT\"; fi\n" +
        "    continue\n" +
        "  fi\n" +
        "  lsha=missing\n" +
        "  [ -e \"$path\" ] && lsha=$(sha_of \"$path\")\n" +
        "  if [ \"$lsha\" = \"$rsha\" ]; then\n" +
        "    if [ \"$MODE\" = \"apply\" ] && [ \"$repo\" = \"tui\" ]; then cp -f \"$path\" \"$BIN/ooda-tui\"; chmod +x \"$BIN/ooda-tui\"; fi\n" +
        "    if [ \"$MODE\" = \"apply\" ] && [ \"$repo\" = \"bb\" ]; then cp -f \"$path\" \"$BIN/blackbox\" 2>/dev/null || true; chmod +x \"$BIN/blackbox\" 2>/dev/null || true; fi\n" +
        "    printf '%s\\t%s\\tok\\tcurrent\\n' \"$repo\" \"$path\" >> \"$RPT\"; continue\n" +
        "  fi\n" +
        "  if [ \"$MODE\" != \"apply\" ]; then printf '%s\\t%s\\tstale\\t%s\\n' \"$repo\" \"$path\" \"$rsha\" >> \"$RPT\"; continue; fi\n" +
        "  tmp=$(mktemp); curl -fsSL --connect-timeout 10 -m 90 \"$url\" -o \"$tmp\" &\n" +
        "  spin $! \"fetch $repo\"\n" +
        "  if [ $? -ne 0 ]; then rm -f \"$tmp\"; printf '%s\\t%s\\tfail\\tdownload\\n' \"$repo\" \"$path\" >> \"$RPT\"; continue; fi\n" +
        "  gsha=$(sha_of \"$tmp\")\n" +
        "  if [ \"$gsha\" != \"$rsha\" ]; then rm -f \"$tmp\"; printf '%s\\t%s\\tfail\\tsha-mismatch\\n' \"$repo\" \"$path\" >> \"$RPT\"; continue; fi\n" +
        "  chmod +x \"$tmp\" 2>/dev/null || true\n" +
        "  mv -f \"$tmp\" \"$path\"\n" +
        "  if [ \"$repo\" = \"tui\" ]; then cp -f \"$path\" \"$BIN/ooda-tui\"; chmod +x \"$BIN/ooda-tui\"; fi\n" +
        "  if [ \"$repo\" = \"bb\" ] && [ -e \"$path\" ]; then cp -f \"$path\" \"$BIN/blackbox\" 2>/dev/null || true; chmod +x \"$BIN/blackbox\" 2>/dev/null || true; fi\n" +
        "  printf '%s\\t%s\\tupdated\\t%s\\n' \"$repo\" \"$path\" \"$rsha\" >> \"$RPT\"\n" +
        "done <<'COMPS'\n" +
        "ooda ooda ooda\n" +
        "cli cli cli\n" +
        "tui tui tui\n" +
        "oodac oodac oodac\n" +
        "oodar liboodar.a liboodar.a\n" +
        "opm opm opm\n" +
        "lsp lsp ooda-lsp\n" +
        "mcp mcp ooda-mcp\n" +
        "bb bb bb\n" +
        "COMPS\n" +
        "STD=\"$PREFIX/std\"\n" +
        "if [ -d \"$STD/.git\" ] && [ \"$MODE\" = \"apply\" ]; then\n" +
        "  git -C \"$STD\" pull --ff-only --quiet 2>/dev/null &\n" +
        "  spin $! std\n" +
        "  if [ $? -eq 0 ]; then printf 'std\\t%s\\tupdated\\tpull\\n' \"$STD\" >> \"$RPT\"\n" +
        "  else printf 'std\\t%s\\tok\\tpresent\\n' \"$STD\" >> \"$RPT\"; fi\n" +
        "elif [ -d \"$STD\" ]; then printf 'std\\t%s\\tok\\tpresent\\n' \"$STD\" >> \"$RPT\"; fi\n" +
        "wipe\n" +
        "exit 0\n";
}

fn pad_right(s: String, w: Int) -> String {
    let mut out: String = s;
    while chars_len(out) < w { out = out + " "; }
    return out;
}

fn status_word(st: String) -> String {
    if st == "ok" { return "current"; }
    if st == "updated" { return "updated"; }
    if st == "stale" { return "stale"; }
    if st == "fail" { return "FAIL"; }
    if st == "skip" { return "skip"; }
    return st;
}

fn print_closer(mode: String, n_up: Int, n_st: Int, n_fail: Int) {
    println("");
    if n_fail > 0 {
        println("  " + int_to_str(n_fail) + " failed");
        return;
    }
    if mode != "apply" && n_st > 0 {
        println("  " + int_to_str(n_st) + " stale  ->  ooda update");
        return;
    }
    if mode == "apply" && n_up > 0 {
        println("  " + int_to_str(n_up) + " updated. latest.");
        return;
    }
    println("  already latest");
}

fn field_at(line: String, idx: Int) -> String {
    let n: Int = chars_len(line);
    let mut start: Int = 0;
    let mut seen: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        let at_end: Bool = i == n;
        let c: String = if at_end { "\t" } else { char_at(line, i) };
        if c == "\t" || at_end {
            if seen == idx { return str_slice(line, start, i); }
            seen = seen + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

pub fn update_run_plan(fr: &FsReadCap, sys: &ProcessCap, mode: String, prefix: String) -> Int {
    let sh: String = update_apply_script(mode, prefix);
    let mut argv: List[String] = list_new();
    argv = list_push(argv, "-c");
    argv = list_push(argv, sh);
    let _r: Result[Int, String] = sys_exec_wait(sys, "bash", argv);
    let rpt: String = update_report_path();
    let cr: Result[String, String] = read_file(fr, rpt);
    if cr.is_err() { println("ERROR: update report missing"); return 1; }
    let body: String = match cr { Ok(s) => s, Err(_) => "" };
    if mode == "check" { println("ooda update --check"); }
    else if mode == "dry" { println("ooda update --dry-run"); }
    else { println("ooda update"); }
    println("");
    let mut n_up: Int = 0;
    let mut n_st: Int = 0;
    let mut n_fail: Int = 0;
    let mut i: Int = 0;
    let n: Int = chars_len(body);
    while i < n {
        if char_at(body, i) == "\n" { i = i + 1; break; }
        i = i + 1;
    }
    while i < n {
        let mut j: Int = i;
        while j < n {
            if char_at(body, j) == "\n" { break; }
            j = j + 1;
        }
        let line: String = str_slice(body, i, j);
        i = j + 1;
        if line == "" { continue; }
        let repo: String = field_at(line, 0);
        let st: String = field_at(line, 2);
        let det: String = field_at(line, 3);
        if st == "updated" { n_up = n_up + 1; }
        else if st == "stale" { n_st = n_st + 1; }
        else if st == "fail" { n_fail = n_fail + 1; }
        let mut extra: String = "";
        if st == "fail" || st == "skip" {
            if det != "" { extra = "  " + det; }
        }
        println("  " + pad_right(repo, 8) + status_word(st) + extra);
    }
    print_closer(mode, n_up, n_st, n_fail);
    if n_fail > 0 { return 1; }
    if mode != "apply" && n_st > 0 { return 1; }
    return 0;
}
