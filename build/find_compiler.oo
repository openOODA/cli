// # Find oodac from one explicit token
//
// Logline: Resolve the compiler path from OODA_COMPILER only. No TOOLCHAIN. No HOME. No PATH.
//
// Setup: &FsReadCap validates the path. &EnvCap reads OODA_COMPILER. Anchor: compiler path is OODA_COMPILER only.
//
// Beats:
//   1. Require OODA_COMPILER. Fail closed when unset or empty.
//   2. Reject a path that does not exist under FsReadCap.
//   3. Reject a path whose basename is the product CLI (`ooda` or `cli`).

import "std/fs/file/path.oo";
import "std/fs/process/env.oo";

pub fn find_oodac(fs: &FsReadCap, env: &EnvCap) -> String {
    let r: Result[String, String] = env_get(env, "OODA_COMPILER");
    let raw: String = match r { Ok(s) => s, Err(_) => "" };
    if raw == "" {
        println("ERR\tcli\tOODA_COMPILER required");
        process_exit(1);
    }
    if !path_exists(fs, raw) {
        println("ERR\tcli\tno oodac at OODA_COMPILER");
        process_exit(1);
    }
    let base: String = path_basename(raw);
    if base == "ooda" || base == "cli" {
        println("ERR\tcli\tOODA_COMPILER is the product CLI");
        process_exit(1);
    }
    return raw;
}
