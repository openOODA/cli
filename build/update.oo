// # cli Self-Update via Canonical Installer
//
// Logline: Fetch install.sh and exec it. After install, run a per-component version check via a spawned bash that writes a tab-separated report file; openOODA reads it back and refuses to print "complete" if any component's installed version differs from GitHub's latest.
//
// Setup: FsReadCap + FsWriteCap + ProcessCap + EnvCap.
//
// Beats:
//   1. Parse --yes, --dry-run, --no-modify-shell, --installer <path>, --check.
//   2. Resolve source: explicit path, OODA_INSTALLER, or canonical URL.
//   3. --check: run the version report; print it; exit non-zero if STALE rows exist.
//   4. Default: exec installer; then run the version report; refuse success on STALE.
//   5. Reject unknown flags and unsafe installer paths fail-closed.

import "std/fs/process/env.oo";
import "std/fs/file/file_reader.oo";

fn update_canonical_url() -> String { return "https://openooda.org/install.sh"; }
fn update_mirror_url() -> String { return "https://raw.githubusercontent.com/openOODA/install/main/install.sh"; }

fn update_has_flag(args: List[String], name: String) -> Bool {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        if list_get(args, i) == name { return true; }
        i = i + 1;
    }
    return false;
}

fn update_argv_installer(args: List[String]) -> String {
    let n: Int = list_len(args);
    let eq: String = "--installer=";
    let mut i: Int = 0;
    while i < n {
        let a: String = list_get(args, i);
        if a == "--installer" {
            if i + 1 < n { return list_get(args, i + 1); }
            return "";
        }
        if chars_len(a) > chars_len(eq) && str_slice(a, 0, chars_len(eq)) == eq {
            return str_slice(a, chars_len(eq), chars_len(a));
        }
        i = i + 1;
    }
    return "";
}

fn update_argv_error(args: List[String]) -> String {
    let n: Int = list_len(args);
    let eq: String = "--installer=";
    let mut i: Int = 0;
    while i < n {
        let a: String = list_get(args, i);
        if a == "--yes" || a == "--dry-run" || a == "--no-modify-shell" || a == "--check" { i = i + 1; continue; }
        if a == "--installer" {
            if i + 1 < n && chars_len(list_get(args, i + 1)) > 0 { i = i + 2; continue; }
            return "--installer needs a path";
        }
        if chars_len(a) > chars_len(eq) && str_slice(a, 0, chars_len(eq)) == eq { i = i + 1; continue; }
        if chars_len(a) > 0 && str_slice(a, 0, 1) == "-" { return "unknown flag: " + a; }
        return "unexpected arg: " + a;
    }
    return "";
}

fn update_installer_unsafe(path: String) -> String {
    if path == "" { return "empty installer path"; }
    if chars_len(path) > 4096 { return "installer path exceeds maximum length"; }
    if str_contains(path, "..") { return "installer path must not contain .."; }
    if str_contains(path, "~") { return "installer path must not contain ~"; }
    if str_contains(path, "'") || str_contains(path, "\"") { return "installer path must not contain quotes"; }
    if str_contains(path, "$") || str_contains(path, "`") { return "installer path must not contain expansion"; }
    if str_contains(path, ";") || str_contains(path, "|") || str_contains(path, "&") { return "installer path must not contain shell metachars"; }
    return "";
}

fn update_passthrough(args: List[String]) -> String {
    let mut flags: String = "";
    if update_has_flag(args, "--dry-run") { flags = flags + " --dry-run"; }
    if update_has_flag(args, "--yes") { flags = flags + " --yes"; }
    if update_has_flag(args, "--no-modify-shell") { flags = flags + " --no-modify-shell"; }
    return flags;
}

// update_version_report_path: returns the temp file the bash script writes to.
fn update_version_report_path() -> String {
    return "/tmp/.ooda-update-report.txt";
}

// update_version_script: bash prints a header, then per-component rows
// (repo<TAB>bin<TAB>installed<TAB>latest), exits 0. Writes to a file
// so openOODA can read it (sys_exec_wait doesn't capture stdout).
fn update_version_script() -> String {
    let rpt: String = update_version_report_path();
    return "HOME=$(getent passwd $(id -un) | cut -d: -f6); export HOME; " +
        "rm -f \"" + rpt + "\"; " +
        "{ printf 'repo\\tbin\\tinstalled\\tlatest\\n'; " +
        "for r in cli tui; do " +
        "  case \"$r\" in " +
        "    cli) b=\"$HOME/.openooda/bin/ooda\" ;; " +
        "    tui) b=\"$HOME/.openooda/bin/ooda-tui\" ;; " +
        "  esac; " +
        "  iv='?'; " +
        "  if [ -x \"$b\" ]; then iv=$(\"$b\" --version 2>/dev/null | grep -oE 'v[0-9]+\\.[0-9]+\\.[0-9]+' | head -1); fi; " +
        "  [ -z \"$iv\" ] && iv='?'; " +
        "  lv='?'; " +
        "  lv=$(curl -fsSL --connect-timeout 5 -m 10 \"https://api.github.com/repos/openOODA/$r/releases/latest\" 2>/dev/null | grep -oE '\"tag_name\": \"v[0-9]+\\.[0-9]+\\.[0-9]+\"' | head -1 | grep -oE 'v[0-9]+\\.[0-9]+\\.[0-9]+'); " +
        "  [ -z \"$lv\" ] && lv='?'; " +
        "  printf '%s\\t%s\\t%s\\t%s\\n' \"$r\" \"$b\" \"$iv\" \"$lv\"; " +
        "done; } > \"" + rpt + "\" 2>/dev/null; " +
        "exit 0";
}

fn update_run_check(fr: &FsReadCap, sys: &ProcessCap) -> Int {
    let sh: String = update_version_script();
    let mut argv: List[String] = list_new();
    argv = list_push(argv, "-c");
    argv = list_push(argv, sh);
    let _r: Result[Int, String] = sys_exec_wait(sys, "bash", argv);
    // Read the report file the script wrote.
    let rpt: String = update_version_report_path();
    let or: Result[FileReader, String] = file_reader_open(fr, rpt);
    let rd: FileReader = match or { Ok(r) => r, Err(_) => return 0; };
    let cr: Result[String, String] = file_reader_read_all(fr, rd);
    let body: String = match cr { Ok(s) => s, Err(_) => "" };
    println("=== cli update --check ===");
    println("repo bin installed latest status");
    let mut stale: Int = 0;
    let mut i: Int = 0;
    let mut n: Int = chars_len(body);
    // Skip header line (until first '\n').
    let mut header_end: Int = 0;
    while header_end < n {
        if char_at(body, header_end) == "\n" { header_end = header_end + 1; break; }
        header_end = header_end + 1;
    }
    while header_end < n {
        let mut line_end: Int = header_end;
        while line_end < n {
            if char_at(body, line_end) == "\n" { break; }
            line_end = line_end + 1;
        }
        let line: String = str_slice(body, header_end, line_end);
        header_end = line_end + 1;
        // Parse repo, bin, installed, latest (TAB-separated).
        let mut tab1: Int = 0;
        while tab1 < chars_len(line) {
            if char_at(line, tab1) == "\t" { break; }
            tab1 = tab1 + 1;
        }
        if tab1 >= chars_len(line) { continue; }
        let repo: String = str_slice(line, 0, tab1);
        let rest: String = str_slice(line, tab1 + 1, chars_len(line));
        let mut tab2: Int = 0;
        while tab2 < chars_len(rest) {
            if char_at(rest, tab2) == "\t" { break; }
            tab2 = tab2 + 1;
        }
        let bin: String = str_slice(rest, 0, tab2);
        let rest2: String = str_slice(rest, tab2 + 1, chars_len(rest));
        let mut tab3: Int = 0;
        while tab3 < chars_len(rest2) {
            if char_at(rest2, tab3) == "\t" { break; }
            tab3 = tab3 + 1;
        }
        let installed: String = str_slice(rest2, 0, tab3);
        let latest: String = str_slice(rest2, tab3 + 1, chars_len(rest2));
        let status: String = if installed == latest { "ok" } else { "STALE" };
        if status == "STALE" { stale = stale + 1; }
        println(repo + " " + bin + " " + installed + " " + latest + " " + status);
        i = i + 1;
    }
    if stale > 0 { println("STALE: run `cli update` to refresh"); return 1; }
    println("OK: every component matches the latest GitHub release");
    return 0;
}

fn update_fetch_script(args: List[String]) -> String {
    let flags: String = update_passthrough(args);
    let primary: String = update_canonical_url();
    let mirror: String = update_mirror_url();
    return "set -o pipefail\n" +
        "HOME=$(getent passwd $(id -un) | cut -d: -f6)\n" +
        "export HOME\n" +
        "TMP=$(mktemp) || exit 1\n" +
        "trap 'rm -f \"$TMP\"' EXIT\n" +
        "if ! curl -fsSL --connect-timeout 10 -m 60 " + primary + " -o \"$TMP\"; then\n" +
        "  if ! curl -fsSL --connect-timeout 10 -m 60 " + mirror + " -o \"$TMP\"; then\n" +
        "    echo 'ERROR: cli update: both primary and mirror failed'\n" +
        "    exit 1\n" +
        "  fi\n" +
        "fi\n" +
        "exec bash \"$TMP\" " + flags + "\n";
}

fn update_exec(sys: &ProcessCap, prog: String, argv: List[String]) {
    let r: Result[Int, String] = sys_exec_wait(sys, prog, argv);
    if r.is_err() {
        let e: String = match r { Ok(_) => "", Err(m) => m };
        println("ERROR: update exec failed: " + e);
        process_exit(1);
    }
    let code: Int = match r { Ok(c) => c, Err(_) => 1 };
    if code != 0 { println("ERROR: installer step failed"); process_exit(1); }
}

pub fn run_ooda_update(fr: &FsReadCap, sys: &ProcessCap, env: &EnvCap, args: List[String]) {
    let bad: String = update_argv_error(args);
    if bad != "" { println("ERROR: " + bad); process_exit(2); }
    if update_has_flag(args, "--check") {
        let rc: Int = update_run_check(fr, sys);
        process_exit(rc);
    }
    let mut src: String = update_argv_installer(args);
    if src == "" {
        let r: Result[String, String] = env_get(env, "OODA_INSTALLER");
        src = match r { Ok(s) => s, Err(_) => "" };
    }
    println("=== cli update ===");
    let mut argv: List[String] = list_new();
    argv = list_push(argv, "-c");
    if src != "" {
        let why: String = update_installer_unsafe(src);
        if why != "" { println("ERROR: " + why); process_exit(2); }
        if !path_exists(fr, src) { println("ERROR: installer not found: " + src); process_exit(1); }
        println("Installer: " + src);
        argv = list_push(argv, "export HOME=\"${HOME:-~}\"; exec bash \"$@\"");
        argv = list_push(argv, "bash");
        argv = list_push(argv, src);
    } else {
        println("Installer: " + update_canonical_url());
        argv = list_push(argv, update_fetch_script(args));
    }
    if update_has_flag(args, "--dry-run") { argv = list_push(argv, "--dry-run"); }
    if update_has_flag(args, "--yes") { argv = list_push(argv, "--yes"); }
    if update_has_flag(args, "--no-modify-shell") { argv = list_push(argv, "--no-modify-shell"); }
    update_exec(sys, "bash", argv);
    println("=== post-install verify ===");
    let rc: Int = update_run_check(fr, sys);
    if rc != 0 {
        println("ERROR: post-install verify failed; installed version(s) do not match GitHub");
        println("Hint: this often means the latest release tag points at a stale asset.");
        process_exit(rc);
    }
    println("=== cli update complete ===");
    println("Restart open harnesses so the new MCP config loads.");
}

