// # cli Self-Update via Canonical Installer
//
// Logline: Fetch the canonical install.sh and exec it to update the toolchain.
//
// Setup: ProcessCap spawns sh or bash; EnvCap reads OODA_INSTALLER; FsReadCap probes an explicit installer path.
//
// Beats:
//   1. Parse --yes, --dry-run, --no-modify-shell, --installer <path>, --check.
//   2. Resolve the source: explicit path, OODA_INSTALLER, or canonical URL.
//   3. If --check: run update_version_table; print table; exit non-zero if stale.
//   4. Otherwise: exec the installer.
//   5. After install completes: run update_version_table again; refuse to print
//      "complete" if any installed binary's version differs from GitHub's
//      latest. Catches the broken-release case (tag is right, asset is stale).
//   6. Reject unknown flags and unsafe installer paths fail-closed.

import "std/fs/process/env.oo";

fn update_canonical_url() -> String {
    return "https://openooda.org/install.sh";
}

fn update_mirror_url() -> String {
    return "https://raw.githubusercontent.com/openOODA/install/main/install.sh";
}

fn update_has_flag(args: List[String], name: String) -> Bool {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        if list_get(args, i) == name { return true; }
        i = i + 1;
    }
    return false;
}

fn update_argv_installer(args: List[String]) -> String {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        let a: String = list_get(args, i);
        if a == "--installer" {
            if i + 1 < n { return list_get(args, i + 1); }
            return "";
        }
        let eq: String = "--installer=";
        if chars_len(a) > chars_len(eq) && str_slice(a, 0, chars_len(eq)) == eq {
            return str_slice(a, chars_len(eq), chars_len(a));
        }
        i = i + 1;
    }
    return "";
}

fn update_argv_error(args: List[String]) -> String {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        let a: String = list_get(args, i);
        if a == "--yes" || a == "--dry-run" || a == "--no-modify-shell" || a == "--check" {
            i = i + 1;
            continue;
        }
        if a == "--installer" {
            if i + 1 < n && chars_len(list_get(args, i + 1)) > 0 {
                i = i + 2;
                continue;
            }
            return "--installer needs a path";
        }
        let eq: String = "--installer=";
        if chars_len(a) > chars_len(eq) && str_slice(a, 0, chars_len(eq)) == eq {
            i = i + 1;
            continue;
        }
        if chars_len(a) > 0 && str_slice(a, 0, 1) == "-" {
            return "unknown flag: " + a;
        }
        return "unexpected arg: " + a;
    }
    return "";
}

fn update_installer_unsafe(path: String) -> String {
    if path == "" { return "empty installer path"; }
    if chars_len(path) > 4096 { return "installer path exceeds maximum length"; }
    if str_contains(path, "..") { return "installer path must not contain .."; }
    if str_contains(path, "~") { return "installer path must not contain ~"; }
    if str_contains(path, "'") || str_contains(path, "\"") { return "installer path must not contain quotes"; }
    if str_contains(path, "$") || str_contains(path, "`") { return "installer path must not contain expansion"; }
    if str_contains(path, ";") || str_contains(path, "|") || str_contains(path, "&") { return "installer path must not contain shell metachars"; }
    return "";
}

fn update_passthrough(args: List[String]) -> String {
    let mut flags: String = "";
    if update_has_flag(args, "--dry-run") { flags = flags + " --dry-run"; }
    if update_has_flag(args, "--yes") { flags = flags + " --yes"; }
    if update_has_flag(args, "--no-modify-shell") { flags = flags + " --no-modify-shell"; }
    return flags;
}

// update_version_table: shell snippet that prints per-component version table.
// Output format: "<repo> <bin> <installed> <latest>\n" rows.
// Always returns 0; the caller greps its stdout.
fn update_version_table() -> String {
    return "set -e\n" +
        "printf 'repo bin installed latest\\n'\n" +
        "for r in cli tui; do\n" +
        "  case \"$r\" in\n" +
        "    cli) bin=~/.openooda/bin/ooda ;;\n" +
        "    tui) bin=~/.openooda/bin/ooda-tui ;;\n" +
        "  esac\n" +
        "  if [ -x \"$bin\" ]; then v=$(\"$bin\" --version 2>&1 | grep -oE 'v[0-9]+\\.[0-9]+\\.[0-9]+' | head -1); fi\n" +
        "  [ -z \"$v\" ] && v='?'\n" +
        "  rel=$(curl -fsSL --connect-timeout 5 -m 10 \"https://api.github.com/repos/openOODA/$r/releases/latest\" 2>/dev/null | grep -oE '\"tag_name\":\"v[0-9]+\\.[0-9]+\\.[0-9]+\"' | head -1 | grep -oE 'v[0-9]+\\.[0-9]+\\.[0-9]+')\n" +
        "  [ -z \"$rel\" ] && rel='?'\n" +
        "  printf '%s %s %s %s\\n' \"$r\" \"$bin\" \"$v\" \"$rel\"\n" +
        "done\n";
}

fn update_run_check(sys: &ProcessCap) -> Int {
    println("=== cli update --check ===");
    println("repo bin installed latest status");
    let mut argv: List[String] = list_new();
    argv = list_push(argv, "-c");
    argv = list_push(argv, update_version_table());
    update_exec(sys, "bash", argv);
    println("=== cli update --check: review the rows above; STALE means run `cli update` ===");
    return 0;
}

fn update_fetch_script(args: List[String]) -> String {
    let flags: String = update_passthrough(args);
    let primary: String = update_canonical_url();
    let mirror: String = update_mirror_url();
    return "set -o pipefail\n" +
        "HOME=$(getent passwd $(id -un) | cut -d: -f6)\n" +
        "export HOME\n" +
        "TMP=$(mktemp) || exit 1\n" +
        "trap 'rm -f \"$TMP\"' EXIT\n" +
        "if ! curl -fsSL --connect-timeout 10 -m 60 " + primary + " -o \"$TMP\"; then\n" +
        "  if ! curl -fsSL --connect-timeout 10 -m 60 " + mirror + " -o \"$TMP\"; then\n" +
        "    echo 'ERROR: cli update: both primary and mirror failed'\n" +
        "    exit 1\n" +
        "  fi\n" +
        "fi\n" +
        "exec bash \"$TMP\" " + flags + "\n";
}

fn update_exec(sys: &ProcessCap, prog: String, argv: List[String]) {
    let r: Result[Int, String] = sys_exec_wait(sys, prog, argv);
    if r.is_err() {
        let e: String = match r { Ok(_) => "", Err(m) => m };
        println("ERROR: update exec failed: " + e);
        process_exit(1);
    }
    let code: Int = match r { Ok(c) => c, Err(_) => 1 };
    if code != 0 {
        println("ERROR: installer step failed");
        process_exit(1);
    }
}

pub fn run_ooda_update(fr: &FsReadCap, sys: &ProcessCap, env: &EnvCap, args: List[String]) {
    let bad: String = update_argv_error(args);
    if bad != "" { println("ERROR: " + bad); process_exit(2); }
    if update_has_flag(args, "--check") {
        update_run_check(sys);
        println("=== cli update complete (check mode) ===");
        return;
    }
    let mut src: String = update_argv_installer(args);
    if src == "" {
        let r: Result[String, String] = env_get(env, "OODA_INSTALLER");
        src = match r { Ok(s) => s, Err(_) => "" };
    }
    println("=== cli update ===");
    if src != "" {
        let why: String = update_installer_unsafe(src);
        if why != "" { println("ERROR: " + why); process_exit(2); }
        if !path_exists(fr, src) { println("ERROR: installer not found: " + src); process_exit(1); }
        println("Installer: " + src);
        let mut argv: List[String] = list_new();
        argv = list_push(argv, "-c");
        argv = list_push(argv, "export HOME=\"${HOME:-~}\"; exec bash \"$@\"");
        argv = list_push(argv, "bash");
        argv = list_push(argv, src);
        if update_has_flag(args, "--dry-run") { argv = list_push(argv, "--dry-run"); }
        if update_has_flag(args, "--yes") { argv = list_push(argv, "--yes"); }
        if update_has_flag(args, "--no-modify-shell") { argv = list_push(argv, "--no-modify-shell"); }
        update_exec(sys, "bash", argv);
        println("=== post-install verify ===");
        update_run_check(sys);
        println("=== cli update complete ===");
        println("Restart open harnesses so the new MCP config loads.");
        return;
    }
    println("Installer: " + update_canonical_url());
    let mut argv: List[String] = list_new();
    argv = list_push(argv, "-c");
    argv = list_push(argv, update_fetch_script(args));
    update_exec(sys, "bash", argv);
    println("=== post-install verify ===");
    update_run_check(sys);
    println("=== cli update complete ===");
    println("Restart open harnesses so the new MCP config loads.");
}
